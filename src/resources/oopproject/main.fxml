<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500.0"
  prefWidth="800.0"
  xmlns="http://javafx.com/javafx/8"
  xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="oopproject.Controller">

  <padding>
    <Insets top="15" right="15" bottom="15" left="15" />
  </padding>

  <left>
    <VBox spacing="10" prefWidth="300">
      <padding>
        <Insets top="5" right="5" bottom="5" left="5" />
      </padding>

      <Label text="Library Items"
        style="-fx-font-size:16px; -fx-font-weight:bold;" />

      <ListView fx:id="itemListView"
        VBox.vgrow="ALWAYS" />
    </VBox>
  </left>

  <center>
    <VBox spacing="12">
      <padding>
        <Insets top="5" right="5" bottom="5" left="5" />
      </padding>

      <Label text="Item Details"
        style="-fx-font-size:16px; -fx-font-weight:bold;" />

      <Label fx:id="itemInfoLabel"
        wrapText="true" />

      <Separator />

      <Label text="User Information"
        style="-fx-font-size:16px; -fx-font-weight:bold;" />

      <Label fx:id="userInfoLabel"
        wrapText="true" />

      <Separator />

      <Label text="Status"
        style="-fx-font-size:16px; -fx-font-weight:bold;" />

      <Label fx:id="statusLabel"
        wrapText="true" />
    </VBox>
  </center>

  <bottom>
    <HBox spacing="10">
      <padding>
        <Insets top="5" right="5" bottom="5" left="5" />
      </padding>

      <ComboBox fx:id="userComboBox"
        promptText="Select a user"
        HBox.hgrow="ALWAYS" />

      <Button fx:id="borrowButton"
        text="Borrow"
        prefWidth="90"
        onAction="#onBorrow" />

      <Button fx:id="returnButton"
        text="Return"
        prefWidth="90"
        onAction="#onReturn" />
    </HBox>
  </bottom>

</BorderPane>